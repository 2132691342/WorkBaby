# Go
/WorkBaby
/WorkBaby.exe
/workbaby.exe
*.exe
# 构建产物：本地 wails build 输出，**不入库**（含可执行文件与 NSIS 安装器）；
# 安装器走 GitHub Actions tag 触发构建并上传到 GitHub Release，
# 避免每次本地构建触发 LFS pointer 变化、git status 永远 modified。
/build/bin/

# Wails
/build/darwin/
/build/windows/
# 安装脚本源码入库（installer/tmp 等构建产物仍忽略）
!/build/windows/
/build/windows/*
!/build/windows/installer/
/build/windows/installer/*
!/build/windows/installer/*.nsi
!/build/windows/installer/*.nsh

# Runtimes（归档经 Git LFS 跟踪，见 .gitattributes）
/runtimes/*.7z

# Frontend
/frontend/node_modules/
/frontend/dist/
# TS 增量构建缓存（vue-tsc -b 产物，不应入库）
*.tsbuildinfo
# 注：wailsjs 绑定（go/、runtime/）现纳入版本控制。CI 的 frontend job 仅安装 Node、不执行
# wails build，若不提交则 vue-tsc 找不到 @/wailsjs/* 模块而失败。代价：本地每次 wails
# build/dev 会重生成这些文件（git status 显示 modified）；修改 Go 导出接口后须本地重新生成
# 并提交，否则 CI 类型门禁会用过期类型。

# Local config / data
/config.local.yaml
/workbaby.db
/workbaby.db-journal
/workbaby.db-wal
/workbaby.db-shm

# 本地测试环境敏感信息（API Key / SMTP 授权码等，勿提交）
/test.env

# IDE
.idea/
.vscode/
*.iml

# Local user dir
*.log

# Nested git repos (submodules)
assets/skills/project-standard/
